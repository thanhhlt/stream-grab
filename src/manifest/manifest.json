{
  "manifest_version": 3,
  "name": "StreamGrab",
  "short_name": "StreamGrab",
  "description": "Detect, download and merge online media streams entirely in your browser.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StreamGrab",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.youtubekids.com/*", "*://*.googlevideo.com/*", "*://youtube.googleapis.com/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "downloads",
    "notifications"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
