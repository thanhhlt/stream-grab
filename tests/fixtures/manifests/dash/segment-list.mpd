<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT12S" minBufferTime="PT2S"
     profiles="urn:mpeg:dash:profile:full:2011">
  <BaseURL>https://media.example.org/content/</BaseURL>
  <Period id="1">
    <AdaptationSet contentType="video" mimeType="video/mp4">
      <Representation id="v1" bandwidth="1000000" width="1280" height="720" codecs="avc1.64001f">
        <BaseURL>video/</BaseURL>
        <SegmentList timescale="1000" duration="4000">
          <Initialization sourceURL="init.mp4"/>
          <SegmentURL media="seg1.m4s"/>
          <SegmentURL media="seg2.m4s"/>
          <SegmentURL media="seg3.m4s"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
    <AdaptationSet contentType="audio" mimeType="audio/mp4" lang="de">
      <Representation id="a1" bandwidth="96000" codecs="mp4a.40.2" audioSamplingRate="48000">
        <BaseURL>https://audio.example.org/de/track.mp4</BaseURL>
        <SegmentList timescale="1000" duration="4000">
          <Initialization range="0-599"/>
          <SegmentURL mediaRange="600-49999"/>
          <SegmentURL mediaRange="50000-99999"/>
          <SegmentURL mediaRange="100000-139999"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
